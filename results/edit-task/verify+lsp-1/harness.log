+/// Today's date as YYYY-MM-DD: `$TALLY_TODAY` if set, else the current local date.
+fn today() -> String {
+    match std::env::var("TALLY_TODAY") {
+        Ok(v) => v,
+        Err(_) => chrono::Local::now().format("%F").to_string(),
+    }
+}
+
+/// True if the task has a due date strictly before `today` (ISO dates compare lexically).
+fn is_overdue(t: &Task, today: &str) -> bool {
+    t.due.as_deref().is_some_and(|due| due < today)
+}
+
+/// Exit with `no task #<id>` on stderr if no task has `id`; otherwise return its index.
+fn task_index(store: &Store, id: u32) -> usize {
+    match store.tasks.iter().position(|t| t.id == id) {
+        Some(i) => i,
+        None => {
+            eprintln!("no task #{}", id);
+            std::process::exit(1);
+        }
+    }
+}
+
