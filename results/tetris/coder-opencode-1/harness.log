import re
src = open('src/main.rs').read()

# explicit returns
fixes = [
 ("        out;\n}", "        return out;\n}"),
 ("""            if y >= 0 && self.board[y][x] != 0 {""",
  """            if y >= 0 && self.board[y as usize][x as usize] != 0 {"""),
 ("        true;\n    }\n\n    fn draw_from_bag", "        return true;\n    }\n\n    fn draw_from_bag"),
 ("        self.bag.pop();\n    }", "        return self.bag.pop().unwrap();\n    }"),
 ("            self.bag = [0, 1, 2, 3, 4, 5, 6];", "            self.bag = vec![0, 1, 2, 3, 4, 5, 6];"),
 ("        true;\n    }\n\n    fn shift", "        return true;\n    }\n\n    fn shift"),
 ("        y;\n    }\n\n    fn gravity_interval_ms", "        return y;\n    }\n\n    fn gravity_interval_ms"),
 ("        800 - 60 * lvl;\n    }", "        return 800 - 60 * lvl;\n    }"),
 ("        Game{\n", "        return Game{\n"),
 ("            board: vec![vec![0; BOARD_W]; BOARD_H],", "            board: vec![vec![0; 10]; 20],"),
 ("        while kept.len() < BOARD_H {", "        while kept.len() < BOARD_H as usize {"),
 ("            self.score += LINE_POINTS[cleared] * (self.level + 1);", "            self.score += LINE_POINTS[cleared as usize] * (self.level + 1);"),
 ("                self.board[y][x] = self.piece as u8 + 1;", "                self.board[y as usize][x as usize] = self.piece as u8 + 1;"),
 ("fn main() -> int {", "fn main() -> i32 {"),
]
for old, new in fixes:
    assert old in src, old
    src = src.replace(old, new, 1)

# replace all set_string calls in main's draw closure with put() helper:
src = src.replace("""            let buf = frame.buffer_mut();
            let plain = Style::new().white();""",
"""            let buf = frame.buffer_mut();
            let plain = Style::new().white();
            let put = |x: i32, y: i32, s: String, st: Style| {
                buf.set_string(x as u16, y as u16, s.to_string(), st);
            };""")
# convert set_string(ARGS, TEXT, STYLE) -> put(...) only inside draw closure (they all use bx/by/panel coords or literals)
def conv(m):
    args = m[1]
    # split top-level commas
    depth=0; parts=[]; cur=""
    for ch in args:
        if ch in '"([': depth+=1
        if ch in '")]': depth-=1
        if ch==',' and depth==0:
            parts.append(cur.strip()); cur=""
        else: cur+=ch
    parts.append(cur.strip())
    assert len(parts)==4, args
    x,y,s,st = parts
    return f"put({x}, {y}, {s}, {st})"
# find set_string( ... ) occurrences with balanced parens
out=[]; i=0
while True:
    j = src.find("buf.set_string(", i)
    if j==-1: break
    k = j + len("buf.set_string(")
    depth=1
    while depth>0:
        c=src[k]
        if c=='(': depth+=1
        elif c==')': depth-=1
        k+=1
    inner = src[j+len("buf.set_string("):k-1]
    out.append(src[i:j] + conv("set_string("+inner))
    i=k
out.append(src[i:])
src = "".join(out)

# string literals passed to put: &str vs String mismatch -> make s param generic impossible; instead wrap literals: put expects String; change calls text arg: if starts with '"' add .to_string()
def fix_text(call):
    # call like put(X, Y, TEXT, STYLE)
    m = re.match(r"put\(([^,]*(?:\([^)]*\)[^,]*)*), ([^,]*(?:\([^)]*\)[^,]*)*), (.*), ([^,]*)\)", call)
    return call
open('src/main.rs','w').write(src)
print("done")
EOF
