        let mut game = game_with_piece(PieceKind::O);
        let first = game.gravity_interval();
        assert!(first <= Duration::from_millis(600));
        // force a level change
        game.lines = 10;
        game.level = 2;
        assert!(game.gravity_interval() < first);
    }
}
