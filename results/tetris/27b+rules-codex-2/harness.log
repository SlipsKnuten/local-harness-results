def board_cells(fname):
    lines = open(fname).read().splitlines()
    out = []
    for li, line in enumerate(lines):
        i = line.find(\"│\")
        if i < 0: continue
        j = line.find(\"│\", i+1)
        if j - i - 1 "'!= 20: continue
        row = line[i+1:j]
        k = 0
        while k < len(row):
            if row[k] == "█":
                start = k
                while k < len(row) and row[k] == "█":
                    k += 1
                for c in range((start//2), (start + (k-start))//2):
                    out.append((li, c))
            else:
                k += 1
    return out

