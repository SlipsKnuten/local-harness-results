/bin/bash -lc "cd /tmp && cat > /tmp/reconstruct.py <<'PY'
import re, sys

data = open('/tmp/tetris_screen.bin','rb').read()
text = data.decode('utf-8', 'replace')

W, H = 80, 24
buf = [[' ']*W for _ in range(H)]
row = col = 0
i = 0
CSI = re.compile(r'\\x1b\\[([0-9;?]*)([A-Za-z])')
def put(ch):
    global row, col
    if ch == '\\r':
        col = 0; return
    if ch == '\\n':
        row += 1; col = 0
        if row >= H: row = H-1
        return
    if ch == '\\x08':
        col = max(0, col-1); return
    if 0 <= row < H and 0 <= col < W:
        buf[row][col] = ch
    col += 1

while i < len(text):
    m = CSI.match(text, i)
    if m:
        params, letter = m.group(1), m.group(2)
        i = m.end()
        if letter in 'Hf':  # cursor position
            nums = [p for p in params.split(';') if p.isdigit()]
            if nums: row = int(nums[0]) - 1
            if len(nums) > 1: col = int(nums[1]) - 1
            row = max(0, min(H-1, row)); col = max(0, min(W-1, col))
        elif letter == 'm':
            pass  # style, ignore
        elif letter == 'J':
            pass
        elif letter == 'K':
            pass
        continue
    put(text[i])
    i += 1

for r in range(H):
    line = ''.join(buf[r]).rstrip()
    print(line)
PY
