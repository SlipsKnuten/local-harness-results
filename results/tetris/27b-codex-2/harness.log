/bin/bash -lc "cd tetris && cargo build --release 2>&1 | tail -2 && python3 - <<'PYEOF'
import pty, os, sys, time, select

pid, fd = pty.fork()
if pid == 0:
    os.execv(\"./target/release/tetris\", [\"./target/release/tetris\"])

def wait_data(timeout=1.0):
    chunks = b\"\"
    end = time.time() + timeout
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.1)
        if r:
            try:
                data = os.read(fd, 65536)
            except OSError:
                break
            if not data:
                break
            chunks += data
    return chunks

out = wait_data(1.5)
# play a bit: rotate, move left x3, hard drop, pause, resume, quit
for k in [b\"\\x1b[A\", b\"\\x1b[D\", b\"\\x1b[D\", b\"\\x1b[D\", b\" \", b\"p\", b\"p\", b\"q\"]:
